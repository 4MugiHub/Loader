local _hookOk = pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if checkcaller() or method ~= "FireServer" or typeof(self) ~= "Instance" then
            return oldNamecall(self, ...)
        end
        local args = {...}
        local n = tostring(self):lower()

        if AntiLogger and (n:find("log") or n:find("error") or n:find("report") or n:find("anticheat") or n:find("ban")) then
            return
        end

        if DoubleDamageGen and n:find("breakgenevent") then
            local myTeam = LocalPlayer.Team
            if myTeam and myTeam.Name:lower():find("killer") then
                local saved = table.clone(args)
                local result = oldNamecall(self, unpack(saved))
                task.spawn(function()
                    for _ = 1, 4 do
                        task.wait(0.08)
                        pcall(function() oldNamecall(self, unpack(saved)) end)
                    end
                end)
                return result
            end
        end

        if SilentAimPistol and n:find("fire") then
            local ok, redirected = pcall(SilentAim_TryRedirect, self, args)
            if ok and redirected then
                return oldNamecall(self, unpack(args))
            end
        end

        return oldNamecall(self, ...)
    end))
end)

if not _hookOk then
    warn("[MugiHub] hookmetamethod tidak tersedia — Silent Aim, Anti-Logger, Double Damage dinonaktifkan.")
    SilentAimPistol = false; AntiLogger = false; DoubleDamageGen = false
    LaserEffectOn = false
    pcall(function() SilentAim_UpdateLaser(nil) end)
end

local _closestKillerDist = 999
local _mainBeatTick = 0
local _parryBeatTick = 0
RunService.Heartbeat:Connect(function()
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local now = tick()

    if now - _mainBeatTick >= 0.1 then
        _mainBeatTick = now
        _closestKillerDist = 999
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local pTeam = p.Team
                if pTeam and (pTeam.Name == "Killer" or pTeam.Name == "Killers") then
                    local eRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if eRoot then
                        local d = (eRoot.Position - myRoot.Position).Magnitude
                        if d < _closestKillerDist then _closestKillerDist = d end
                    end
                end
            end
        end
        pcall(function() UpdateWarningMark(myRoot, _closestKillerDist) end)
    end

    if AutoParry then pcall(TriggerParryDagger) end
end)

