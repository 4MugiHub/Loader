GateSection:AddButton({
    Title   = "Bypass Gate",
    Content = "Teleport to Fininsline part in the map",
    Callback = function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = character:FindFirstChild("HumanoidRootPart")

        if not hrp then
            MugiHub:SetNotification({
                Title = "Bypass Gate", Description = "Failed",
                Content = "HumanoidRootPart not found.", Delay = 3
            })
