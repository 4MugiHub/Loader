-- Section: Auto Attack
----------------------------------------------------------------
local AutoAtkSection = KillerTab:AddSection("Auto Attack", false)

local AA_Enabled = false
local AA_Range   = 10
local AA_Conn    = nil
local AA_Cooldown = 0
local AA_CD_Time  = 0.3

local function AA_FindTarget()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closest, closestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Team and
           (p.Team.Name == "Survivors" or p.Team.Name == "Survivor") and
           p.Character then
            local tHRP = p.Character:FindFirstChild("HumanoidRootPart")
            if tHRP then
                local dist = (tHRP.Position - hrp.Position).Magnitude
                if dist < closestDist and dist <= AA_Range then
                    closestDist = dist
                    closest = p
                end
            end
        end
    end
    return closest
end

local function AA_Start()
    if AA_Conn then return end
    AA_Conn = RunService.Heartbeat:Connect(function()
        if not AA_Enabled or not IsKiller() then return end
        local now = tick()
        if now - AA_Cooldown < AA_CD_Time then return end
        AA_Cooldown = now
        local target = AA_FindTarget()
        if not target then return end
        pcall(function()
            ReplicatedStorage
                :WaitForChild("Remotes")
                :WaitForChild("Attacks")
                :WaitForChild("BasicAttack")
                :FireServer(false)
        end)
    end)
end

local function AA_Stop()
    if AA_Conn then AA_Conn:Disconnect(); AA_Conn = nil end
end

