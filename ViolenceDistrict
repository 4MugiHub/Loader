local function GetUIScale()
    local cam = Workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local shortSide = math.min(vp.X, vp.Y)
    local scale = shortSide / 720
    return math.clamp(scale, 0.75, 1.35)
end

local function setPopupState(open)
    SilentIsOpen = open
    if SilentPopFrame then SilentPopFrame.Visible = open end
    if SilentMinimizeBtn then
        SilentMinimizeBtn.Text = open and "-" or "+"
    end
end

local function togglePopup()
    setPopupState(not SilentIsOpen)
end

local function updateSelectionVisual(name)
    for optName, btn in pairs(SilentOptionButtons) do
        if optName == name then
            btn.BackgroundColor3 = OPTION_COLORS[optName]
