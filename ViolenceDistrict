        if state then
            if not IsKiller() then
                MugiHub:SetNotification({ Title="Auto Attack", Description="You're not the killer", Delay=3 })
                AA_Enabled = false; return
            end
            AA_Start()
            MugiHub:SetNotification({ Title="Auto Attack", Description="Auto attacking within "..AA_Range.." studs", Delay=3 })
        else
            AA_Stop()
            MugiHub:SetNotification({ Title="Auto Attack", Description="Auto attack off", Delay=3 })
        end
    end
})

