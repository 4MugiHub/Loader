local function ESP_ApplyHighlight(obj, color)
    if not obj or not obj.Parent then return end
    local adornee = obj
    if obj:IsA("MeshPart") or obj:IsA("UnionOperation") or obj:IsA("BasePart") then
        local parent = obj.Parent
        if parent and parent:IsA("Model") then adornee = parent end
    end
    if not adornee or not adornee.Parent then return end

    local h = adornee:FindFirstChild("MugiESP_H")
    if not h then
        h = Instance.new("Highlight")
        h.Name = "MugiESP_H"
        h.Parent = adornee
    end
    h.Adornee = adornee
    h.FillColor = color; h.OutlineColor = color
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local refPos = nil
    pcall(function()
        if adornee:IsA("Model") then
            refPos = adornee:GetPivot().Position
        elseif adornee:IsA("BasePart") then
            refPos = adornee.Position
        end
    end)
    if refPos and myRoot then
        local dist = (refPos - myRoot.Position).Magnitude
        if dist > 120 then
            h.FillTransparency = 0.92; h.OutlineTransparency = 0
        elseif dist > 70 then
            h.FillTransparency = 0.88; h.OutlineTransparency = 0.02
        else
            h.FillTransparency = 0.80; h.OutlineTransparency = 0.05
        end
    else
        h.FillTransparency = 0.82; h.OutlineTransparency = 0.05
    end
    h.Enabled = true
end

local function ESP_RemoveHighlight(obj)
    if not obj or not obj.Parent then return end
    local target = obj
    if (obj:IsA("MeshPart") or obj:IsA("BasePart") or obj:IsA("UnionOperation")) and obj.Parent and obj.Parent:IsA("Model") then
        target = obj.Parent
    end
    local h = target:FindFirstChild("MugiESP_H")
    if h then pcall(function() h:Destroy() end) end
end

local function ESP_ApplyPlayerLabel(char, player, isKiller, myHRP)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local hum = char:FindFirstChild("Humanoid")
    local dist = (hrp and myHRP) and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0

    local color, statusText
    if isKiller then
        local detectedMask = char:GetAttribute("CachedMask") or char:GetAttribute("KillerType")
            or GetGameValue(char,"SelectedKiller") or GetGameValue(player,"SelectedKiller")
            or GetGameValue(char,"Mask") or char.Name
        if detectedMask then char:SetAttribute("CachedMask", detectedMask) end
        statusText = MaskNames[detectedMask] or "KILLER"
        color = ESP_KillColor
    else
        local function IsActive(v) return v == true or (type(v) == "number" and v > 0) end
        local hooked  = IsActive(GetGameValue(char,"IsHooked")) or IsActive(GetGameValue(player,"IsHooked"))
        local carried = IsActive(GetGameValue(char,"Carried")) or IsActive(GetGameValue(char,"IsCarried")) or IsActive(GetGameValue(char,"Grabbed"))
        local knocked = IsActive(GetGameValue(char,"Knocked")) or IsActive(GetGameValue(char,"IsKnocked"))
        if hooked then
            color = Color3.fromRGB(255,40,120); statusText = "HOOKED"
        elseif carried then
            color = Color3.fromRGB(160,70,255); statusText = "CARRIED"
        elseif knocked then
            color = Color3.fromRGB(255,160,0); statusText = "KNOCKED"
        elseif hum and hum.Health < hum.MaxHealth then
