GenSection:AddButton({
    Title   = "Complete All Generators",
    Content = "Instantly complete all generators in the map",
    Callback = function()
        if not IsSurvivor() then
            MugiHub:SetNotification({ Title="Auto Generators", Description="Survivors only", Delay=3 }); return
        end
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local genR    = remotes and remotes:FindFirstChild("Generator")
        local repairE = genR and genR:FindFirstChild("RepairEvent")
        local skillE  = genR and genR:FindFirstChild("SkillCheckResultEvent")
        if not repairE or not skillE then
            MugiHub:SetNotification({ Title="Auto Generators", Description="Game not ready yet", Delay=3 }); return
        end
        local map = Workspace:FindFirstChild("Map")
        if not map then
            MugiHub:SetNotification({ Title="Auto Generators", Description="Map not loaded yet", Delay=3 }); return
        end
        local searchIn = map:FindFirstChild("Gens") or map
        local completed = 0
        for _, obj in ipairs(searchIn:GetDescendants()) do
            if obj:IsA("Model") and obj.Name == "Generator" then
                for _, point in ipairs(obj:GetChildren()) do
                    if point.Name:find("GeneratorPoint") then
                        completed = completed + 1
                        task.spawn(function()
                            -- Fire repairE bertahap agar server catat progress
                            -- lalu akhiri dengan skillE success agar benar-benar complete
                            for _ = 1, 15 do
                                pcall(function() repairE:FireServer(point, false) end)
                                task.wait(0.05)
                            end
                            -- Trigger skill check success di akhir agar goal tercapai
                            pcall(function() skillE:FireServer("success", 1, obj, point) end)
                            task.wait(0.1)
                            pcall(function() repairE:FireServer(point, true) end)
                        end)
                    end
                end
            end
        end
        MugiHub:SetNotification({
            Title="Auto Generators",
            Description = completed > 0
                and string.format("All generators done! (%d points)", completed)
                or "No generator points found",
            Delay=3
        })
