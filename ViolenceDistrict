local MugiHub
do
    local fetchOk, fetchResult = pcall(function()
        return game:HttpGet(MUGIHUB_URL)
    end)
    if not fetchOk or type(fetchResult) ~= "string" or #fetchResult < 10 then
        error("[MugiHub] Failed to download the UI library. Check your internet connection or executor HTTP settings. URL: " .. MUGIHUB_URL)
    end

    local compileFn, compileErr = loadstring(fetchResult)
    if type(compileFn) ~= "function" then
        error("[MugiHub] Downloaded library failed to compile (stale CDN cache or bad response). Compile error: " .. tostring(compileErr))
    end

    local runOk, runResult = pcall(compileFn)
    if not runOk or type(runResult) ~= "table" then
        error("[MugiHub] Library loaded but did not return a valid table. Run error: " .. tostring(runResult))
    end

    MugiHub = runResult
end

