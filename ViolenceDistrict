local function ESP_StartLoop()
    if ESP_ConnLoop then return end
    local _espTick = 0
    local _espGenTick = 0
    ESP_ConnLoop = RunService.Heartbeat:Connect(function()
        if not ESP_Enabled then return end
        local now = tick()

        if now - _espTick >= 0.15 then
            _espTick = now
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LocalPlayer then continue end
                local char = p.Character; if not char then continue end
                local team = p.Team and p.Team.Name or ""
                local hum = char:FindFirstChild("Humanoid")
                if not hum or hum.Health <= 0 then
                    pcall(function() ESP_RemoveHighlight(char) end)
                    pcall(function() ESP_RemovePlayerLabel(char) end)
                    continue
                end
                local isKiller = team:lower():find("killer") ~= nil
                if isKiller and ESP_Killers then
                    pcall(function() ESP_ApplyPlayerLabel(char, p, true, myHRP) end)
                elseif not isKiller and ESP_Survivors then
                    pcall(function() ESP_ApplyPlayerLabel(char, p, false, myHRP) end)
                else
                    pcall(function() ESP_RemoveHighlight(char) end)
                    pcall(function() ESP_RemovePlayerLabel(char) end)
                end
            end
        end

        if ESP_Generators and now - _espGenTick >= 0.5 then
            _espGenTick = now
            for i = #ESP_ActiveGens, 1, -1 do
                local g = ESP_ActiveGens[i]
                if not g or not g.Parent then
                    table.remove(ESP_ActiveGens, i)
                elseif ESP_ShowGenProg then
                    local done = false
                    pcall(function() done = ESP_UpdateGenBar(g) end)
                    if done then table.remove(ESP_ActiveGens, i) end
                else
                    pcall(function() ESP_ApplyHighlight(g, ESP_GenColor) end)
                end
            end
        end
    end)
    Workspace.ChildAdded:Connect(function(c)
        if c.Name == "Map" and ESP_Enabled then task.wait(1); ESP_RefreshObjects() end
    end)
end

local function ESP_StopLoop()
    if ESP_ConnLoop then ESP_ConnLoop:Disconnect(); ESP_ConnLoop = nil end
    ESP_ClearAll()
end

