local function IsBotDisabled()
    local char = LocalPlayer.Character
    if not char then return true end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return true end
    if char:GetAttribute("IsHooked") or char:GetAttribute("Carried") or char:GetAttribute("Grabbed") then return true end
    return false
end

local function StartAutoBot()
    if AutoBotConn then AutoBotConn:Disconnect(); AutoBotConn = nil end
    if not AutoBotEnabled or not IsSurvivorTeam() then return end
    AutoBotConn = RunService.Heartbeat:Connect(function()
        if not AutoBotEnabled or not IsSurvivorTeam() or IsBotDisabled() then
            if AutoBotConn then AutoBotConn:Disconnect(); AutoBotConn = nil end; return
        end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        local myPos = root.Position
        local now = tick()

        local killerPos, killerDist = nil, 999
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local t = p.Team
                if t and (t.Name == "Killer" or t.Name == "Killers") then
                    local eRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if eRoot then
                        local d = (eRoot.Position - myPos).Magnitude
                        if d < killerDist then killerDist = d; killerPos = eRoot.Position end
                    end
                end
            end
        end

        local target, state = nil, "Idle"
        if AutoBotEvade and killerDist <= 70 and killerPos then
            local dir = (myPos - killerPos).Unit
            target = myPos + dir * 50; state = "Evade"
        end

        if not target and AutoBotHeal then
            local best, bestDist = nil, 90
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local eHum = p.Character:FindFirstChild("Humanoid")
                    local eRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if eHum and eRoot and eHum.Health > 0 and eHum.Health < eHum.MaxHealth then
                        local d = (eRoot.Position - myPos).Magnitude
                        if d < bestDist then bestDist = d; best = p.Character end
                    end
                end
            end
            if best then
                target = best.HumanoidRootPart.Position; state = "Heal"
                if bestDist <= 12 then
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                    if remotes then
                        local heal = remotes:FindFirstChild("HealEvent", true) or remotes:FindFirstChild("RequestHeal", true)
                        if heal then pcall(function() heal:FireServer(best, 100) end) end
                    end
                    return
                end
            end
        end

        if not target and AutoBotRepair then
            local bestGen, bestDist = nil, 150
            for _, gen in ipairs(CachedMapObjects.Generators) do
                if gen and gen.Parent then
                    local prog = GetGameValue(gen, "RepairProgress") or GetGameValue(gen, "Progress") or 0
                    if prog < 100 then
                        local gPos = gen:GetPivot().Position
                        local d = (gPos - myPos).Magnitude
                        if d < bestDist then bestDist = d; bestGen = gPos end
                    end
                end
            end
            if bestGen then target = bestGen; state = "Repair" end
        end

        if target then
            if not BotTarget or (BotTarget - target).Magnitude > 5 or now - BotLastPath > 1.5 then
                BotTarget = target; BotLastPath = now
                task.spawn(function()
                    pcall(function()
                        local path = PathfindingService:CreatePath({AgentRadius=AutoBotRadius,AgentHeight=5,AgentCanJump=true,WaypointSpacing=AutoBotSpacing})
                        path:ComputeAsync(myPos, target)
                        if path.Status == Enum.PathStatus.Success then
                            BotWaypoints = path:GetWaypoints()
                        else
                            BotWaypoints = {}
                        end
                    end)
                end)
            end
            if #BotWaypoints > 0 then
                local next = BotWaypoints[1]
                if next then
                    local wp = next.Position
                    if (Vector3.new(wp.X,myPos.Y,wp.Z) - myPos).Magnitude < 4.5 then
                        table.remove(BotWaypoints, 1); next = BotWaypoints[1]
                    end
                    if next then
                        hum:MoveTo(next.Position)
                        if next.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
                    end
                end
            else
                hum:MoveTo(target)
            end
        else
            BotWaypoints = {}; BotTarget = nil
        end
    end)
end

