local function GetPing()
    local ping = 0.08
    pcall(function()
        local s = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
        if s and s > 0 then ping = s end
    end)
    return math.clamp(ping, 0.03, 1.5)
end

