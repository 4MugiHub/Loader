                Title = "Server Hop", Description = "Failed",
                Content = "No other available server found.", Delay = 3
            })
            return
        end

        local chosen = candidates[math.random(1, #candidates)]
        MugiHub:SetNotification({
            Title = "Server Hop", Description = "Hopping...",
            Content = "Teleporting to a new server.", Delay = 3
        })
