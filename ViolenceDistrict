local Line     = Check:WaitForChild("Line")
local Goal     = Check:WaitForChild("Goal")

-- State
local SC_Mode    = "Instant"   -- "Instant" | "Legit"
local SC_Enabled = false
local SC_Conn    = nil         -- heartbeat / visible connection
local SC_VisConn = nil

