local COUNTDOWN_TIME = 68.7

local function CancelCountdown()
    if MaskCountdown then
        task.cancel(MaskCountdown)
        MaskCountdown = nil
    end
end

local function StartCountdown(onDone)
    CancelCountdown()
    MaskTimeLeft = COUNTDOWN_TIME
    MaskCountdown = task.spawn(function()
        while MaskTimeLeft > 0 do
            task.wait(0.1)
            MaskTimeLeft = math.max(0, MaskTimeLeft - 0.1)
        end
        if onDone then onDone() end
    end)
end

