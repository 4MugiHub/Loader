----------------------------------------------------------------
-- Helpers
----------------------------------------------------------------
local function PressSpace()
    VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.Space, false, game)
    task.wait(0.01)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end

local function LineInGoal()
    local lr = Line.Rotation % 360
    local gr = Goal.Rotation % 360
    local gs = (gr + 104) % 360
    local ge = (gr + 114) % 360
    if gs > ge then
        return lr >= gs or lr <= ge
    else
        return lr >= gs and lr <= ge
    end
end

local function IsSurvivor()
    return LocalPlayer.Team ~= nil and LocalPlayer.Team.Name == "Survivors"
end

----------------------------------------------------------------
-- Mode logic
----------------------------------------------------------------
local function StopSkillCheck()
    if SC_Conn then SC_Conn:Disconnect(); SC_Conn = nil end
end

-- LEGIT: tunggu Line masuk Goal baru press
local function HeartbeatLegit()
    if not IsSurvivor() then StopSkillCheck(); return end
    if LineInGoal() then
        PressSpace()
        StopSkillCheck()
    end
end

-- INSTANT: langsung press begitu Check visible
local function OnCheckVisibleInstant()
    if not SC_Enabled then return end
    if not IsSurvivor() then return end
    if Check.Visible then
        PressSpace()
    end
end

-- LEGIT: pasang heartbeat waktu Check visible
local function OnCheckVisibleLegit()
    if not SC_Enabled then return end
    if not IsSurvivor() then StopSkillCheck(); return end
    if Check.Visible then
        StopSkillCheck()
        SC_Conn = RunService.Heartbeat:Connect(HeartbeatLegit)
    else
        StopSkillCheck()
    end
end

----------------------------------------------------------------
-- Enable / Disable
----------------------------------------------------------------
local function StartSkillCheck()
    -- bersihkan koneksi lama dulu
    if SC_VisConn then SC_VisConn:Disconnect(); SC_VisConn = nil end
    StopSkillCheck()

    if SC_Mode == "Instant" then
        SC_VisConn = Check:GetPropertyChangedSignal("Visible"):Connect(OnCheckVisibleInstant)
    else
        SC_VisConn = Check:GetPropertyChangedSignal("Visible"):Connect(OnCheckVisibleLegit)
    end
end

local function StopAll()
    if SC_VisConn then SC_VisConn:Disconnect(); SC_VisConn = nil end
    StopSkillCheck()
end

