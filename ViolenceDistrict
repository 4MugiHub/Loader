    local hrp=char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local bb=hrp:FindFirstChild("MugiESP_Label"); if bb then bb:Destroy() end
end

local function ESP_UpdateGenBar(gen)
    if not gen or not gen.Parent then return true end
    local progress = ESP_GetValue(gen,"RepairProgress") or ESP_GetValue(gen,"Progress") or 0
    progress = math.clamp(progress, 0, 100)
    if progress >= 100 then
        local bb=gen:FindFirstChild("MugiESP_GenBar"); if bb then bb:Destroy() end
        ESP_RemoveHighlight(gen); return true
    end

    local myHRP  = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local genPart = gen:FindFirstChildWhichIsA("BasePart")
    local dist = (myHRP and genPart) and (myHRP.Position - genPart.Position).Magnitude or 0

    local t = math.clamp(1 - (dist/150), 0, 1)
    local barWidth = 20 + 50*t

    local r,g
    if progress <= 50 then r=255; g=math.floor(255*(progress/50))
    else r=math.floor(255*(1-(progress-50)/50)); g=255 end
    local barColor = Color3.fromRGB(r,g,0)

    local bb = gen:FindFirstChild("MugiESP_GenBar")
    if not bb then
        bb=Instance.new("BillboardGui"); bb.Name="MugiESP_GenBar"
        bb.AlwaysOnTop=true; bb.StudsOffset=Vector3.new(0,1.2,0); bb.Parent=gen
        local bg=Instance.new("Frame",bb); bg.Name="BG"
        bg.BackgroundColor3=Color3.fromRGB(20,20,20); bg.BorderSizePixel=0
        bg.AnchorPoint=Vector2.new(0.5,0); bg.Position=UDim2.new(0.5,0,0,0)
        local bgS=Instance.new("UIStroke",bg); bgS.Color=Color3.fromRGB(80,80,80); bgS.Thickness=1
        local fill=Instance.new("Frame",bg); fill.Name="Fill"
        fill.BackgroundColor3=barColor; fill.BorderSizePixel=0
        fill.AnchorPoint=Vector2.new(0,0); fill.Position=UDim2.new(0,0,0,0); fill.Size=UDim2.new(0,0,1,0)
        local pct=Instance.new("TextLabel",bb); pct.Name="Pct"
        pct.BackgroundTransparency=1; pct.AnchorPoint=Vector2.new(0.5,0)
        pct.Size=UDim2.new(0,50,0,10); pct.Font=Enum.Font.GothamBold; pct.TextSize=8
        pct.TextColor3=Color3.fromRGB(220,220,220); pct.TextStrokeTransparency=0
        pct.TextStrokeColor3=Color3.new(0,0,0); pct.TextXAlignment=Enum.TextXAlignment.Center
    end

    bb.Size=UDim2.new(0,barWidth,0,22)
    local bg=bb:FindFirstChild("BG"); local fill=bg and bg:FindFirstChild("Fill"); local pct=bb:FindFirstChild("Pct")
    if bg then bg.Size=UDim2.new(0,barWidth,0,10); bg.Position=UDim2.new(0.5,0,0,0) end
    if fill then fill.Size=UDim2.new(0,math.floor(barWidth*(progress/100)),1,0); fill.BackgroundColor3=barColor end
    if pct then pct.Text=math.floor(progress).."%"; pct.Position=UDim2.new(0.5,0,0,13) end
    if ESP_Generators then ESP_ApplyHighlight(gen, ESP_GenColor) end
    return false
end

local function ESP_RefreshObjects()
    ESP_ActiveGens = {}
    local map = Workspace:FindFirstChild("Map")
    if not map then return end
    for _, obj in ipairs(map:GetDescendants()) do
        if obj.Name=="Generator" and obj:IsA("Model") then
            table.insert(ESP_ActiveGens, obj)
        elseif obj.Name=="Hook" and ESP_Hooks then
            local m=obj:FindFirstChild("Model")
            if m then for _,p in ipairs(m:GetDescendants()) do if p:IsA("MeshPart") then ESP_ApplyHighlight(p,ESP_HookColor) end end end
        elseif (obj.Name=="Palletwrong" or obj.Name=="Pallet") and ESP_Pallets then
            ESP_ApplyHighlight(obj, ESP_PalletColor)
        elseif obj.Name=="Gate" and ESP_Gates then
            ESP_ApplyHighlight(obj, ESP_GateColor)
        end
    end
    if ESP_Windows then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name=="Window" then ESP_ApplyHighlight(obj, ESP_WindowColor) end
        end
    end
end

local function ESP_ClearAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then ESP_RemoveHighlight(p.Character); ESP_RemovePlayerLabel(p.Character) end
    end
    local map=Workspace:FindFirstChild("Map")
    if map then
        for _, obj in ipairs(map:GetDescendants()) do
            ESP_RemoveHighlight(obj)
            local bb=obj:FindFirstChild("MugiESP_GenBar"); if bb then bb:Destroy() end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do ESP_RemoveHighlight(obj) end
    ESP_ActiveGens = {}
end

local function ESP_StartLoop()
    if ESP_ConnLoop then return end
    -- RefreshObjects hanya dipanggil setelah ESP_Enabled = true
    ESP_ConnLoop = RunService.Heartbeat:Connect(function()
        if not ESP_Enabled then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local char=p.Character; if not char then continue end
            local team=p.Team and p.Team.Name or ""
            local hrp=char:FindFirstChild("HumanoidRootPart")
            local myHRP=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local dist=(hrp and myHRP) and math.floor((hrp.Position-myHRP.Position).Magnitude) or 0
            if team=="Survivors" and ESP_Survivors then
                ESP_ApplyHighlight(char, ESP_SurvColor)
                ESP_ApplyPlayerLabel(char, p.Name..(ESP_ShowDistSurv and "\n"..dist.."m" or ""), ESP_SurvColor)
            elseif team=="Killer" and ESP_Killers then
                ESP_ApplyHighlight(char, ESP_KillColor)
                ESP_ApplyPlayerLabel(char, p.Name..(ESP_ShowDistKill and "\n"..dist.."m" or ""), ESP_KillColor)
            else
                ESP_RemoveHighlight(char); ESP_RemovePlayerLabel(char)
            end
        end
        if ESP_Generators and ESP_ShowGenProg then
            for i=#ESP_ActiveGens,1,-1 do
                local g=ESP_ActiveGens[i]
                if not g or not g.Parent then table.remove(ESP_ActiveGens,i)
                elseif ESP_UpdateGenBar(g) then table.remove(ESP_ActiveGens,i) end
            end
        elseif ESP_Generators then
            for _, g in ipairs(ESP_ActiveGens) do ESP_ApplyHighlight(g, ESP_GenColor) end
        end
    end)
    Workspace.ChildAdded:Connect(function(c)
        if c.Name=="Map" then task.wait(1); ESP_RefreshObjects() end
    end)
end

local function ESP_StopLoop()
    if ESP_ConnLoop then ESP_ConnLoop:Disconnect(); ESP_ConnLoop=nil end
    ESP_ClearAll()
end

