            btn.UIStroke.Transparency = 0.2
        else
            btn.BackgroundColor3 = COLOR_BUTTON_DEFAULT
            btn.UIStroke.Color = Color3.fromRGB(70,70,80)
            btn.UIStroke.Transparency = 0.4
        end
    end
end

