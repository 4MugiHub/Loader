GenSection:AddSeperator({"Instant Complete"})

GenSection:AddButton({
    Title   = "Complete All Generators",
    Content = "Instantly complete all generators in the map",
    Callback = function()
        if not IsSurvivor() then
            MugiHub:SetNotification({
                Title = "Auto Generators", Description = "Failed",
                Content = "You must be a Survivor.", Delay = 3
            })
            return
        end

        local map = Workspace:FindFirstChild("Map")
        if not map then
            MugiHub:SetNotification({
                Title = "Auto Generators", Description = "Failed",
                Content = "Map not found.", Delay = 3
            })
            return
        end

        local remotes         = ReplicatedStorage:FindFirstChild("Remotes")
        local genRemotes      = remotes and remotes:FindFirstChild("Generator")
        local repairEvent     = genRemotes and genRemotes:FindFirstChild("RepairEvent")
        local skillCheckEvent = genRemotes and genRemotes:FindFirstChild("SkillCheckResultEvent")

        if not repairEvent or not skillCheckEvent then
            MugiHub:SetNotification({
                Title = "Auto Generators", Description = "Failed",
                Content = "Remotes not found.", Delay = 3
            })
            return
        end

        local completed = 0
        for _, obj in ipairs(map:GetDescendants()) do
            if obj:IsA("Model") and obj.Name == "Generator" then
                for _, point in ipairs(obj:GetChildren()) do
                    if point.Name:find("GeneratorPoint") then
                        pcall(function()
                            for _ = 1, 10 do
                                repairEvent:FireServer(point, true)
                                skillCheckEvent:FireServer("success", 1, obj, point)
                            end
                        end)
                        completed = completed + 1
                    end
                end
            end
        end

        MugiHub:SetNotification({
            Title = "Auto Generators",
            Description = completed > 0 and "Success" or "Failed",
            Content = completed > 0
                and string.format("Completed %d generator point(s).", completed)
                or "No generator points found.",
            Delay = 3
        })
    end
})

