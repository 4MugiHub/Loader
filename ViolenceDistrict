local PrevESPState = {Generator=false,Pallet=false,Gate=false,Hook=false}

local function ESP_RefreshObjects()
    if not ESP_Enabled then return end
    ESP_ActiveGens = {}
    local map = Workspace:FindFirstChild("Map")
    if not map then return end
    for _, obj in ipairs(map:GetDescendants()) do
        local n = obj.Name
        if n == "Generator" and obj:IsA("Model") then
            table.insert(ESP_ActiveGens, obj)
            if not PrevESPState.Generator then PrevESPState.Generator = true end
        elseif n == "Hook" and obj:IsA("Model") and ESP_Hooks then
            ESP_ApplyHighlight(obj, ESP_HookColor)
        elseif (n == "Palletwrong" or n == "Pallet") and ESP_Pallets then
            local function IsActive(val) return val==true or (type(val)=="number" and val>0) end
            local isDropped = IsActive(GetGameValue(obj,"Dropped")) or IsActive(GetGameValue(obj,"IsDropped"))
            local isBroken  = IsActive(GetGameValue(obj,"Broken")) or IsActive(GetGameValue(obj,"IsBroken"))
            if not isDropped and not isBroken then
                pcall(function() ESP_ApplyHighlight(obj, ESP_PalletColor) end)

                local tag = obj:FindFirstChild("PalletESP_Tag")
                if not tag then
                    local bb = Instance.new("BillboardGui"); bb.Name = "PalletESP_Tag"
                    bb.AlwaysOnTop = true; bb.Size = UDim2.new(0,55,0,18); bb.MaxDistance = 140
                    local targetPart = obj:FindFirstChildWhichIsA("BasePart", true)
                    if not targetPart and obj:IsA("Model") then
                        pcall(function() targetPart = obj:GetPivot() and obj:FindFirstChildWhichIsA("BasePart", true) end)
                    end
                    if targetPart then bb.Adornee = targetPart end
                    bb.Parent = obj
                    local lbl = Instance.new("TextLabel",bb)
                    lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1
                    lbl.Text = "<b>[PALLET]</b>"; lbl.RichText = true
                    lbl.TextColor3 = ESP_PalletColor; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 7
                end
            else
                pcall(function() ESP_RemoveHighlight(obj) end)
                local tag2 = obj:FindFirstChild("PalletESP_Tag")
                if tag2 then tag2:Destroy() end
            end
        elseif n == "Gate" and ESP_Gates then
            ESP_ApplyHighlight(obj, ESP_GateColor)
        end
    end
    if ESP_Windows then
        local map2 = Workspace:FindFirstChild("Map")
        if map2 then
            for _, obj in ipairs(map2:GetDescendants()) do
                if obj.Name == "Window" then
                    pcall(function() ESP_ApplyHighlight(obj, ESP_WindowColor) end)
                end
            end
        end
    end
end

