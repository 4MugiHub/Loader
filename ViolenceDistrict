    progress = math.clamp(progress, 0, 100)
    if progress >= 100 then
        local bb = gen:FindFirstChild("MugiESP_GenBar"); if bb then bb:Destroy() end
        ESP_RemoveHighlight(gen); return true
    end
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local genPos = nil
    pcall(function()
        if gen:IsA("Model") then genPos = gen:GetPivot().Position
        else genPos = gen.Position end
    end)
    if not genPos then
        local genPart = gen:FindFirstChildWhichIsA("BasePart")
        if genPart then genPos = genPart.Position end
