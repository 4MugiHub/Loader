local function SilentAim_IsSCP(v)
    if not (v and v:IsA("Model")) then return false end
    local nm = v.Name:lower()
    return nm == "scp" or nm:match("^scp%d*$") or nm:match("^scp[%-_]?%d+$")
        or nm:find("zombie") or nm:find("monster") or nm:find("infected") or nm:find("mutant")
end

local function SilentAim_GetValidPlayerTargets(kind)
    local out = {}
    local myTeam = LocalPlayer.Team
    local myIsKiller = myTeam and (myTeam.Name == "Killer" or myTeam.Name == "Killers")
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local pTeam = p.Team
        local pIsKiller = pTeam and (pTeam.Name == "Killer" or pTeam.Name == "Killers")
        local wantKiller  = (kind == "Killer") and pIsKiller
        local wantSurvivor = (kind == "Survivor") and not pIsKiller
        if wantKiller or wantSurvivor then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum  = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                table.insert(out, root)
            end
        end
    end
    return out
end

local function SilentAim_GetValidZombieTargets()
    local out = {}
    for _, v in ipairs(Workspace:GetChildren()) do
        if SilentAim_IsSCP(v) then
            local root = v:FindFirstChild("HumanoidRootPart")
            if not root then
                local ok, pp = pcall(function() return v.PrimaryPart end)
                root = (ok and pp) or v:FindFirstChildWhichIsA("BasePart")
            end
            local hum = v:FindFirstChildOfClass("Humanoid")
            if root and (not hum or hum.Health > 0) then
                table.insert(out, root)
            end
        end
    end
    return out
end

local function SilentAim_GetClosestTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local center = cam.ViewportSize * 0.5

    local pool
    if SilentTargetKind == "Zombie" then
        pool = SilentAim_GetValidZombieTargets()
    else
        pool = SilentAim_GetValidPlayerTargets(SilentTargetKind)
    end
    if #pool == 0 then return nil end

    local fov = SilentAimFOV
    if SilentAimMode == "Brutal" then fov = fov * 1.4 end

    local best, bestDist = nil, fov
    for _, root in ipairs(pool) do
        if root and root.Parent then
            local pos, onScreen = cam:WorldToViewportPoint(root.Position)
            if onScreen then
                if SilentWallCheck and not IsTargetVisible(root) then
                    continue
                end
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if dist < bestDist then bestDist = dist; best = root end
            end
        end
    end
    return best
end

local function SilentAim_IsSelfDisabled()
    local char = LocalPlayer.Character
    if not char then return true end
    local function IsActive(v) return v == true or (type(v) == "number" and v > 0) end
    if IsActive(GetGameValue(char, "Knocked")) or IsActive(GetGameValue(char, "IsKnocked")) then return true end
    if IsActive(GetGameValue(char, "IsHooked")) then return true end
    if IsActive(GetGameValue(char, "Carried")) or IsActive(GetGameValue(char, "IsCarried")) then return true end
    if IsActive(GetGameValue(char, "Grabbed")) then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    return false
end

local function SilentAim_EnsureLaser()
    if SilentLaserBeam and SilentLaserBeam.Parent then return SilentLaserBeam end
    local a0 = Instance.new("Attachment"); a0.Name = "SilentLaserA0"
    local a1 = Instance.new("Attachment"); a1.Name = "SilentLaserA1"
    local part0 = Instance.new("Part")
    part0.Name = "SilentLaserAnchor0"; part0.Anchored = true; part0.CanCollide = false
    part0.Transparency = 1; part0.Size = Vector3.new(0.1,0.1,0.1); part0.Parent = Workspace
    a0.Parent = part0
    local part1 = Instance.new("Part")
    part1.Name = "SilentLaserAnchor1"; part1.Anchored = true; part1.CanCollide = false
    part1.Transparency = 1; part1.Size = Vector3.new(0.1,0.1,0.1); part1.Parent = Workspace
    a1.Parent = part1

    local beam = Instance.new("Beam")
    beam.Name = "SilentLaserBeam"
    beam.Attachment0 = a0; beam.Attachment1 = a1
    beam.Width0 = 0.06; beam.Width1 = 0.06
    beam.Color = ColorSequence.new(Color3.fromRGB(255, 40, 40))
    beam.Transparency = NumberSequence.new(0.15)
    beam.FaceCamera = true
    beam.Segments = 1
    beam.LightEmission = 1
    beam.Parent = part0

    SilentLaserBeam = {
        Beam = beam, Part0 = part0, Part1 = part1, A0 = a0, A1 = a1
    }
    return SilentLaserBeam
end

local function SilentAim_UpdateLaser(target)
    if not LaserEffectOn then
        if SilentLaserBeam then
            pcall(function() SilentLaserBeam.Part0:Destroy() end)
            pcall(function() SilentLaserBeam.Part1:Destroy() end)
            SilentLaserBeam = nil
        end
        return
    end
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    local muzzle = tool and (tool:FindFirstChild("Muzzle", true) or tool:FindFirstChild("Handle"))
    local origin
    if muzzle then
        origin = muzzle.Position
    else
        local cam = Workspace.CurrentCamera
        origin = cam and cam.CFrame.Position
    end
    if not origin or not target or not target.Parent then
        if SilentLaserBeam then
            pcall(function() SilentLaserBeam.Beam.Enabled = false end)
        end
        return
    end
    local laser = SilentAim_EnsureLaser()
    laser.Beam.Enabled = true
    laser.Part0.CFrame = CFrame.new(origin)
    laser.Part1.CFrame = CFrame.new(target.Position)
end

function SilentAim_TryRedirect(self, args)
    if not SilentAimPistol then return false end
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not (myRoot and tool) then return false end

    if SilentAimMode == "Safe" and SilentAim_IsSelfDisabled() then
        return false
    end

    local firing = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if not firing and not IsMobile then return false end

    local target = SilentAim_GetClosestTarget()
    SilentTarget = target
    if not target or not target.Parent then return false end

    local vel = target.AssemblyLinearVelocity or Vector3.zero
    if vel.Magnitude > 45 then vel = vel.Unit * 45 end
    local ping = math.clamp(GetPing(), 0.05, 0.18)
    local leadTime = 0.10 + ping
    local predicted = target.Position + (vel * leadTime)

    local origin = Workspace.CurrentCamera.CFrame.Position
    local dir = (predicted - origin)
    if dir.Magnitude < 0.01 then return false end
    dir = dir.Unit * 1000

    local foundVector = false
    for i, v in ipairs(args) do
        if typeof(v) == "Vector3" then
            args[i] = dir
            foundVector = true
            break
        end
    end
    if not foundVector then return false end

    return true
end

RunService.RenderStepped:Connect(function()
    if not SilentAimPistol then
        if SilentLaserBeam then SilentAim_UpdateLaser(nil) end
        return
    end
    local holding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if holding or IsMobile then
        SilentTarget = SilentAim_GetClosestTarget()
    else
        SilentTarget = nil
    end
    SilentAim_UpdateLaser(SilentTarget)
end)

