-- Helper: GetGameValue (attribute atau Value child)
local function ESP_GetValue(obj, name)
    if not obj then return nil end
    local attr = obj:GetAttribute(name)
    if attr ~= nil then return attr end
    local child = obj:FindFirstChild(name)
    if child then
        local ok, v = pcall(function() return child.Value end)
        if ok then return v end
    end
    return nil
end

-- Helper: Highlight
local function ESP_ApplyHighlight(obj, color)
    if not obj or not obj.Parent then return end
    local h = obj:FindFirstChild("MugiESP_H") or Instance.new("Highlight")
    h.Name             = "MugiESP_H"
    h.Adornee          = obj
    h.FillColor        = color
    h.OutlineColor     = color
    h.FillTransparency = 0.75
    h.OutlineTransparency = 0.2
    h.DepthMode        = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent           = obj
end

local function ESP_RemoveHighlight(obj)
    if not obj then return end
    local h = obj:FindFirstChild("MugiESP_H")
    if h then h:Destroy() end
end

-- Helper: Billboard label player
local function ESP_ApplyPlayerLabel(char, text, color)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local bb = hrp:FindFirstChild("MugiESP_Label")
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name          = "MugiESP_Label"
        bb.AlwaysOnTop   = true
        bb.Size          = UDim2.new(0, 120, 0, 28)
        bb.StudsOffset   = Vector3.new(0, 3, 0)
        bb.Adornee       = hrp
        bb.Parent        = hrp
        local lbl = Instance.new("TextLabel", bb)
        lbl.Name                  = "Lbl"
        lbl.Size                  = UDim2.new(1,0,1,0)
        lbl.BackgroundTransparency= 1
        lbl.Font                  = Enum.Font.GothamBold
        lbl.TextSize              = 11
        lbl.TextStrokeTransparency= 0
        lbl.TextStrokeColor3      = Color3.new(0,0,0)
        lbl.TextWrapped           = true
    end
    local lbl = bb:FindFirstChild("Lbl")
    if lbl then lbl.Text = text; lbl.TextColor3 = color end
end

local function ESP_RemovePlayerLabel(char)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local bb = hrp:FindFirstChild("MugiESP_Label")
    if bb then bb:Destroy() end
end

-- Generator progress bar billboard
-- Bar mengecil/melebar sesuai jarak, warna smooth merah→hijau
local function ESP_UpdateGenBar(gen)
    if not gen or not gen.Parent then return true end

    local progress = ESP_GetValue(gen, "RepairProgress")
                  or ESP_GetValue(gen, "Progress")
                  or 0
    progress = math.clamp(progress, 0, 100)

    -- Kalau sudah 100%, hapus
    if progress >= 100 then
        local bb = gen:FindFirstChild("MugiESP_GenBar")
        if bb then bb:Destroy() end
        ESP_RemoveHighlight(gen)
        return true
    end

    -- Hitung jarak
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local genPart = gen:FindFirstChildWhichIsA("BasePart")
    local dist = 0
    if myHRP and genPart then
        dist = (myHRP.Position - genPart.Position).Magnitude
    end

    -- Skala bar: makin jauh makin sempit (min 30px, max 110px)
    local maxDist   = 200
    local minWidth  = 30
    local maxWidth  = 110
    local t         = math.clamp(1 - (dist / maxDist), 0, 1)
    local barWidth  = minWidth + (maxWidth - minWidth) * t

    -- Warna smooth merah → kuning → hijau
    local r, g
    if progress <= 50 then
        local f = progress / 50
        r = 255
        g = math.floor(255 * f)
    else
        local f = (progress - 50) / 50
        r = math.floor(255 * (1 - f))
        g = 255
    end
    local barColor = Color3.fromRGB(r, g, 0)

    -- Billboard
    local bb = gen:FindFirstChild("MugiESP_GenBar")
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name        = "MugiESP_GenBar"
        bb.AlwaysOnTop = true
        bb.StudsOffset = Vector3.new(0, 4.5, 0)
        bb.Parent      = gen

        -- Background bar (abu gelap)
        local bg = Instance.new("Frame", bb)
        bg.Name                  = "BG"
        bg.BackgroundColor3      = Color3.fromRGB(30, 30, 30)
        bg.BorderSizePixel       = 0
        bg.AnchorPoint           = Vector2.new(0.5, 0.5)
        bg.Position              = UDim2.new(0.5, 0, 0.5, 0)
        Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)
        local stroke = Instance.new("UIStroke", bg)
        stroke.Color     = Color3.fromRGB(60, 60, 60)
        stroke.Thickness = 1

        -- Fill bar
        local fill = Instance.new("Frame", bg)
        fill.Name             = "Fill"
        fill.BackgroundColor3 = barColor
        fill.BorderSizePixel  = 0
        fill.AnchorPoint      = Vector2.new(0, 0.5)
        fill.Position         = UDim2.new(0, 0, 0.5, 0)
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    end

    -- Update ukuran billboard & bar berdasarkan jarak
    bb.Size = UDim2.new(0, barWidth + 8, 0, 14)

    local bg   = bb:FindFirstChild("BG")
    local fill = bg and bg:FindFirstChild("Fill")
    if bg then
        bg.Size = UDim2.new(0, barWidth, 0, 8)
    end
    if fill then
        -- Smooth color update
        fill.Size             = UDim2.new(progress / 100, 0, 1, 0)
        fill.BackgroundColor3 = barColor
    end

    -- Highlight generator pakai warna progress juga
    if ESP_Generators then
        ESP_ApplyHighlight(gen, barColor)
    end

    return false
end

-- Refresh semua ESP object (hook, pallet, gate, window)
local function ESP_RefreshObjects()
    ESP_ActiveGens = {}
    local map = Workspace:FindFirstChild("Map")
    if not map then return end
    for _, obj in ipairs(map:GetDescendants()) do
        if obj.Name == "Generator" and obj:IsA("Model") then
            table.insert(ESP_ActiveGens, obj)
        elseif obj.Name == "Hook" then
            local m = obj:FindFirstChild("Model")
            if m then
                for _, p in ipairs(m:GetDescendants()) do
                    if p:IsA("MeshPart") then
                        ESP_ApplyHighlight(p, Color3.fromRGB(132, 255, 169))
                    end
                end
            end
        elseif obj.Name == "Palletwrong" or obj.Name == "Pallet" then
            ESP_ApplyHighlight(obj, Color3.fromRGB(74, 255, 181))
        elseif obj.Name == "Gate" then
            ESP_ApplyHighlight(obj, Color3.fromRGB(255, 255, 255))
        end
    end
    -- Window di luar Map
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "Window" then
            ESP_ApplyHighlight(obj, Color3.fromRGB(74, 255, 181))
        end
    end
end

local function ESP_ClearAll()
    -- Hapus label & highlight player
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            ESP_RemoveHighlight(p.Character)
            ESP_RemovePlayerLabel(p.Character)
        end
    end
    -- Hapus highlight objects di Map
    local map = Workspace:FindFirstChild("Map")
    if map then
        for _, obj in ipairs(map:GetDescendants()) do
            ESP_RemoveHighlight(obj)
            local bb = obj:FindFirstChild("MugiESP_GenBar")
            if bb then bb:Destroy() end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        ESP_RemoveHighlight(obj)
    end
    ESP_ActiveGens = {}
end

local function ESP_StartLoop()
    if ESP_ConnLoop then return end
    ESP_RefreshObjects()
    ESP_ConnLoop = RunService2.Heartbeat:Connect(function()
        if not ESP_Enabled then return end

        -- Player ESP
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            local char = p.Character
            if not char then continue end
            local team = p.Team and p.Team.Name or ""
            local hrp  = char:FindFirstChild("HumanoidRootPart")
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local dist = (hrp and myHRP) and math.floor((hrp.Position - myHRP.Position).Magnitude) or 0

            if team == "Survivors" and ESP_Survivors then
                ESP_ApplyHighlight(char, ESP_SurvColor)
                local txt = p.Name
                if ESP_ShowDistSurv then txt = txt .. "\n" .. dist .. "m" end
                ESP_ApplyPlayerLabel(char, txt, ESP_SurvColor)
            elseif team == "Killer" and ESP_Killers then
                ESP_ApplyHighlight(char, ESP_KillColor)
                local txt = p.Name
                if ESP_ShowDistKill then txt = txt .. "\n" .. dist .. "m" end
                ESP_ApplyPlayerLabel(char, txt, ESP_KillColor)
            else
                ESP_RemoveHighlight(char)
                ESP_RemovePlayerLabel(char)
            end
        end

        -- Generator progress bar
        if ESP_Generators and ESP_ShowGenProg then
            for i = #ESP_ActiveGens, 1, -1 do
                local g = ESP_ActiveGens[i]
                if not g or not g.Parent then
                    table.remove(ESP_ActiveGens, i)
                elseif ESP_UpdateGenBar(g) then
                    table.remove(ESP_ActiveGens, i)
                end
            end
        elseif ESP_Generators then
            for _, g in ipairs(ESP_ActiveGens) do
                ESP_ApplyHighlight(g, ESP_GenColor)
            end
        end
    end)

    -- Auto re-scan kalau map baru load
    Workspace.ChildAdded:Connect(function(c)
        if c.Name == "Map" then task.wait(1); ESP_RefreshObjects() end
    end)
end

local function ESP_StopLoop()
    if ESP_ConnLoop then ESP_ConnLoop:Disconnect(); ESP_ConnLoop = nil end
    ESP_ClearAll()
end

