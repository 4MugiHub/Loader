RunService.RenderStepped:Connect(function(dt)
    if not AimbotEnabled then return end
    local now = time()
    if now - lastRenderCheck > 0.08 then
        lastRenderCheck = now
        local myChar = LocalPlayer.Character
        if myChar then
            cachedIsCarrying = GetGameValue(myChar,"Carrying") or GetGameValue(myChar,"IsCarrying") or false
        end
    end
    if cachedIsCarrying then AimbotTarget = nil; return end
    if now - LastTargetCheck > 0.1 then
        LastTargetCheck = now
        AimbotTarget = GetClosestAimbotTarget(AimbotTarget)
    end
    if AimbotTarget and (not AimbotTarget.Parent or not AimbotTarget:IsDescendantOf(Workspace)) then
        AimbotTarget = nil
    end
    if AimbotTarget and AimbotTarget.Parent then
        local triggerAuto = AimbotTrigger == "Auto"
        local triggerHold = AimbotTrigger == "Hold" and (
            UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or
            UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        )
        if triggerAuto or triggerHold then
            local cam = Workspace.CurrentCamera
            if cam then
                local smooth = math.clamp(dt * 8, 0.05, 0.3)
                cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, AimbotTarget.Position), smooth)
            end
        end
    end
end)

