            SearchIn(Workspace)
        end

        if target then
            hrp.CFrame = target.CFrame + Vector3.new(0, 4, 0)
            MugiHub:SetNotification({
                Title = "Bypass Gate", Description = "Success",
                Content = "Teleported to Fininsline.", Delay = 3
