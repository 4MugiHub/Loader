-- SkillCheck refs (async, tidak hang)
local Check, Line, Goal
local SC_Mode      = "Instant"
local SC_Enabled   = false
local SC_VisConn   = nil
local SC_HeartConn = nil

local ActionPath = "Survivor-mob.Controls.action.check"
local TouchID    = 8822

local function GetActionTarget()
    local cur = PG
    for seg in string.gmatch(ActionPath, "[^%.]+") do
        cur = cur and cur:FindFirstChild(seg)
    end
    return cur
end

local function TriggerMobileButton()
    local b = GetActionTarget()
    if b and b:IsA("GuiObject") then
        local p, s, ins = b.AbsolutePosition, b.AbsoluteSize, GuiService:GetGuiInset()
        local cx = p.X + s.X/2 + ins.X
        local cy = p.Y + s.Y/2 + ins.Y
        pcall(function()
            VirtualInputManager:SendTouchEvent(TouchID, 0, cx, cy)
            task.wait(0.01)
            VirtualInputManager:SendTouchEvent(TouchID, 2, cx, cy)
        end)
    end
end

local function PressSpace()
    VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.Space, false, game)
    task.wait(0.01)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end

local function IsSurvivor()
    return LocalPlayer.Team ~= nil and
        (LocalPlayer.Team.Name == "Survivors" or LocalPlayer.Team.Name == "Survivor")
end

local function LineInGoal()
    if not Line or not Goal then return false end
    local lr = Line.Rotation % 360
    local gr = Goal.Rotation % 360
    local ss = (gr + 101) % 360
    local se = (gr + 115) % 360
    return (ss > se and (lr >= ss or lr <= se)) or (lr >= ss and lr <= se)
end

local function StopSkillCheck()
    if SC_HeartConn then SC_HeartConn:Disconnect(); SC_HeartConn = nil end
end

local function StopAll()
    if SC_VisConn then SC_VisConn:Disconnect(); SC_VisConn = nil end
    StopSkillCheck()
end

local function SetupRefs()
    task.spawn(function()
        pcall(function()
            local prompt = PG:WaitForChild("SkillCheckPromptGui", 15)
            if not prompt then return end
            Check = prompt:WaitForChild("Check", 10)
            if not Check then return end
            Line  = Check:WaitForChild("Line",  5)
            Goal  = Check:WaitForChild("Goal",  5)
        end)
    end)
end

SetupRefs()
LocalPlayer.CharacterAdded:Connect(function() task.wait(2); SetupRefs() end)

local function StartInstant()
    if SC_VisConn then SC_VisConn:Disconnect() end
    SC_VisConn = Check:GetPropertyChangedSignal("Visible"):Connect(function()
        if not IsSurvivor() then StopSkillCheck(); return end
        if Check.Visible then
            StopSkillCheck()
            SC_HeartConn = RunService.Heartbeat:Connect(function()
                if not Check or not Check.Visible then StopSkillCheck(); return end
                TriggerMobileButton()
                PressSpace()
            end)
        else
            StopSkillCheck()
        end
    end)
end

local function StartLegit()
    if SC_VisConn then SC_VisConn:Disconnect() end
    SC_VisConn = Check:GetPropertyChangedSignal("Visible"):Connect(function()
        if not (IsSurvivor() and Check.Visible) then StopSkillCheck(); return end
        StopSkillCheck()
        SC_HeartConn = RunService.Heartbeat:Connect(function()
            if not (Line and Goal) then return end
            if LineInGoal() then
                TriggerMobileButton()
                PressSpace()
                StopSkillCheck()
            end
        end)
    end)
end

local function StartSkillCheck()
    StopAll()
    task.spawn(function()
        local t = 0
        while not Check and t < 10 do task.wait(0.5); t = t + 0.5 end
        if not Check then return end
        if SC_Mode == "Instant" then StartInstant() else StartLegit() end
    end)
end

