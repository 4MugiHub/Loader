        local function SearchIn(parent)
            for _, obj in ipairs(parent:GetDescendants()) do
                if obj.Name == "Fininsline" and obj:IsA("BasePart") then
                    target = obj
                    return
                end
            end
        end

        -- 1. Cari di dalam folder/model Map kalau ada
        local mapFolder = Workspace:FindFirstChild("Map")
        if mapFolder then
            SearchIn(mapFolder)
        end

        -- 2. Kalau belum ketemu, cari seluruh Workspace
