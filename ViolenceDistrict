    minimize.AutoButtonColor = false
    minimize.Text = ""
    minimize.BorderSizePixel = 0
    minimize.ZIndex = 5
    minimize.Parent = root
    local mCorner = Instance.new("UICorner", minimize); mCorner.CornerRadius = UDim.new(0, 8)
    local mStroke = Instance.new("UIStroke", minimize)
    mStroke.Color = COLOR_ACCENT; mStroke.Thickness = 1; mStroke.Transparency = 0.5

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Name = "Title"
    titleLbl.Size = UDim2.new(1, -BTN_H, 1, 0)
    titleLbl.Position = UDim2.new(0, PAD, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = "Silent Aim Target"
    titleLbl.TextColor3 = Color3.fromRGB(230, 230, 235)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = math.floor(12 * scale)
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
    titleLbl.ZIndex = 6
    titleLbl.Parent = minimize

    local toggleBtn = Instance.new("TextLabel")
    toggleBtn.Name = "ToggleSymbol"
    toggleBtn.Size = UDim2.new(0, BTN_H, 0, BTN_H)
    toggleBtn.Position = UDim2.new(1, -BTN_H, 0, 0)
    toggleBtn.BackgroundTransparency = 1
    toggleBtn.Text = "+"
    toggleBtn.TextColor3 = COLOR_ACCENT
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextSize = math.floor(16 * scale)
    toggleBtn.ZIndex = 6
    toggleBtn.Parent = minimize
    SilentMinimizeBtn = toggleBtn

    local popFrame = Instance.new("Frame")
    popFrame.Name = "PopFrame"
    popFrame.Size = UDim2.new(1, 0, 0, (BTN_H * 3) + (PAD * 4))
    popFrame.Position = UDim2.new(0, 0, 0, BTN_H + PAD)
    popFrame.BackgroundColor3 = COLOR_PANEL_BG
    popFrame.BorderSizePixel = 0
    popFrame.Visible = false
    popFrame.ZIndex = 5
    popFrame.Parent = root
    local pCorner = Instance.new("UICorner", popFrame); pCorner.CornerRadius = UDim.new(0, 8)
    local pStroke = Instance.new("UIStroke", popFrame)
    pStroke.Color = COLOR_ACCENT; pStroke.Thickness = 1; pStroke.Transparency = 0.55

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, PAD * 0.6)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.Parent = popFrame

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, PAD)
    padding.PaddingBottom = UDim.new(0, PAD)
    padding.PaddingLeft = UDim.new(0, PAD)
    padding.PaddingRight = UDim.new(0, PAD)
    padding.Parent = popFrame

    local OPTIONS = {"Killer", "Survivor", "Zombie"}
    for i, name in ipairs(OPTIONS) do
        local btn = Instance.new("TextButton")
        btn.Name = name
        btn.LayoutOrder = i
        btn.Size = UDim2.new(1, -PAD*2, 0, BTN_H)
        btn.BackgroundColor3 = COLOR_BUTTON_DEFAULT
        btn.AutoButtonColor = false
        btn.Text = name
        btn.TextColor3 = Color3.fromRGB(240, 240, 245)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = math.floor(12 * scale)
        btn.BorderSizePixel = 0
        btn.ZIndex = 6
        btn.Parent = popFrame
        local bCorner = Instance.new("UICorner", btn); bCorner.CornerRadius = UDim.new(0, 6)
        local bStroke = Instance.new("UIStroke", btn)
        bStroke.Color = Color3.fromRGB(70,70,80); bStroke.Thickness = 1; bStroke.Transparency = 0.4
        btn.UIStroke = bStroke

        btn.MouseButton1Click:Connect(function()
            API.SetSelected(name)
            MugiHub:SetNotification({
                Title = "Silent Aim", Description = "Target set to " .. name, Delay = 2
            })
        end)

        SilentOptionButtons[name] = btn
    end

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        popFrame.Size = UDim2.new(1, 0, 0, listLayout.AbsoluteContentSize.Y + PAD*2)
    end)

    local dragging = false
    local dragStart = nil
    local startPos = nil
    local moved = false
    local DRAG_THRESHOLD = 4

    local function beginDrag(pos)
        dragging = true
        moved = false
        dragStart = pos
        startPos = root.Position
    end

    local function updateDrag(pos)
        if not dragging then return end
        local delta = pos - dragStart
        if delta.Magnitude > DRAG_THRESHOLD then moved = true end
        local viewportSize = screenGui.AbsoluteSize
        if viewportSize.X <= 0 or viewportSize.Y <= 0 then return end
        local newX = startPos.X.Scale + (delta.X / viewportSize.X)
        local newY = startPos.Y.Scale + (delta.Y / viewportSize.Y)
        newX = math.clamp(newX, -0.1, 1.02)
        newY = math.clamp(newY, 0, 0.95)
        root.Position = UDim2.new(newX, startPos.X.Offset, newY, startPos.Y.Offset)
    end

    local function endDrag()
        dragging = false
    end

    minimize.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            beginDrag(Vector2.new(input.Position.X, input.Position.Y))
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch) then
            updateDrag(Vector2.new(input.Position.X, input.Position.Y))
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                local wasClick = not moved
                endDrag()
                if wasClick then
                    togglePopup()
                end
            end
        end
    end)

    local keyConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not screenGui.Parent then return end
        local focused = UserInputService:GetFocusedTextBox()
        if focused then return end
        if input.KeyCode == Enum.KeyCode.Minus or input.KeyCode == Enum.KeyCode.KeypadMinus then
            togglePopup()
        end
    end)

    screenGui.AncestryChanged:Connect(function(_, parent)
        if not parent and keyConn then keyConn:Disconnect() end
    end)

    SilentGui = screenGui
    SilentPopFrame = popFrame

    setPopupState(false)
    for _, btn in pairs(SilentOptionButtons) do
        btn.BackgroundColor3 = COLOR_BUTTON_DEFAULT
    end
end

