local function ESP_GetValue(obj, name)
    if not obj then return nil end
    local attr = obj:GetAttribute(name)
    if attr ~= nil then return attr end
    local child = obj:FindFirstChild(name)
    if child then local ok,v=pcall(function() return child.Value end); if ok then return v end end
    return nil
end

local function ESP_ApplyHighlight(obj, color)
    if not obj or not obj.Parent then return end
    local h = obj:FindFirstChild("MugiESP_H") or Instance.new("Highlight")
    h.Name="MugiESP_H"; h.Adornee=obj; h.FillColor=color; h.OutlineColor=color
    h.FillTransparency=0.75; h.OutlineTransparency=0.2
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=obj
end

local function ESP_RemoveHighlight(obj)
    if not obj then return end
    local h = obj:FindFirstChild("MugiESP_H")
    if h then h:Destroy() end
end

local function ESP_ApplyPlayerLabel(char, text, color)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local bb = hrp:FindFirstChild("MugiESP_Label")
    if not bb then
        bb=Instance.new("BillboardGui"); bb.Name="MugiESP_Label"; bb.AlwaysOnTop=true
        bb.Size=UDim2.new(0,120,0,28); bb.StudsOffset=Vector3.new(0,3,0)
        bb.Adornee=hrp; bb.Parent=hrp
