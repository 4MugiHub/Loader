UpdateParryRing = function()
    if not ParryRing or not ParryRing.Parent then return end
    if RemoveParryCircle or not AutoParry then
        ParryRing.Enabled = false
    else
        ParryRing.Enabled = true
        local cam = Workspace.CurrentCamera
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if cam and root then
            local _, onScreen = cam:WorldToViewportPoint(root.Position)
            if onScreen then
                local edgeWorld = root.Position + cam.CFrame.RightVector * ParryDistance
                local edgeScreen, _ = cam:WorldToViewportPoint(edgeWorld)
                local centerScreen, _ = cam:WorldToViewportPoint(root.Position)
                local radius = math.clamp(math.abs(edgeScreen.X - centerScreen.X), 20, 400)
                local ring = ParryRing:FindFirstChild("Ring")
                if ring then
                    ring.Size = UDim2.new(0, radius*2, 0, radius*2)
                end
